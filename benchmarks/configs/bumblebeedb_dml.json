    },
    {
      "test": "dml_txn_autocommit",
      "file": "txn_autocommit.sql",
      "num_tries": 1,
      "driver": "stdin"
    },
    {
      "test": "dml_txn_single",
      "file": "txn_single.sql",
      "num_tries": 1,
      "driver": "stdin"
    },
    {
      "test": "dml_insert_join",
      "file": "insert_join.sql",
      "num_tries": 1
    },
    {
