{
  "engine": "bumblebeedb",
  "db": "data/db/bbdb_olap.db",
  "reset_db": true,
  "setup": [
    "data/setup/bumblebeedb_olap.sql"
  ],
  "setup_cmd": "${BBDB_BIN:-../build/BumbleBee} --db $DB --no-seed --test-protocol --max-memory 8589934592 < $FILE",
  "run_cmd": "${BBDB_BIN:-../build/BumbleBee} --db $DB --no-seed --test-protocol --max-memory 8589934592 -c \"$(cat $FILE)\"",
  "stdin_cmd": "${BBDB_BIN:-../build/BumbleBee} --db $DB --no-seed --test-protocol --max-memory 8589934592 < $FILE",
  "comparison_config": "configs/duckdb_olap.json",
  "query_dir": "queries/olap",
  "previous_comparison": true,
