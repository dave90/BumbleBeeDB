# DELETE removes a row's primary-key index entry, so the key can be re-inserted afterwards. Keys that
# were NOT deleted still enforce uniqueness.

statement ok
CREATE TABLE pk(id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO pk VALUES (1, 10);

statement ok
INSERT INTO pk VALUES (2, 20);

statement ok
DELETE FROM pk WHERE id = 1;

query
SELECT COUNT(*) FROM pk;
----
1

# The deleted key (1) can be re-inserted...
statement ok
INSERT INTO pk VALUES (1, 99);

# ...but a key that still exists (2) is still rejected.
statement error
INSERT INTO pk VALUES (2, 30);

query rowsort
SELECT id, v FROM pk;
----
1 99
2 20

# Deleting every row lets all keys be re-inserted.
statement ok
DELETE FROM pk;

statement ok
INSERT INTO pk VALUES (1, 5), (2, 6), (3, 7);

query rowsort
SELECT id, v FROM pk;
----
1 5
2 6
3 7
