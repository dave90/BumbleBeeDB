# INSERT ... SELECT reading the table it inserts into. The scan's snapshot is taken when the scan
# starts (page directory + tail-slot cap), so the rows the INSERT appends are NOT visible to its own
# SELECT — each statement exactly doubles the table instead of chasing its own tail forever (the
# Halloween problem). The insert sink buffers its chunks and applies them only after the scan has
# drained (Combine), which is also what makes writing to the scanned table deadlock-free.

statement ok
CREATE TABLE t(v INT);

statement ok
INSERT INTO t VALUES (1), (2), (3);

# Each self-insert doubles the row count; values are duplicated, not re-multiplied.
query
INSERT INTO t SELECT v FROM t;
----
3

query
SELECT COUNT(*), SUM(v) FROM t;
----
6 12

query
INSERT INTO t SELECT v FROM t;
----
6

query
SELECT COUNT(*), SUM(v), MIN(v), MAX(v) FROM t;
----
12 24 1 3

# With a WHERE: only the matching snapshot rows are re-inserted.
query
INSERT INTO t SELECT v FROM t WHERE v = 1;
----
4

query
SELECT COUNT(*), SUM(v) FROM t;
----
16 28

# Self-insert inside an explicit transaction, rolled back: the doubling is undone.
statement ok
BEGIN;

query
INSERT INTO t SELECT v FROM t;
----
16

query
SELECT COUNT(*) FROM t;
----
32

statement ok
ROLLBACK;

query
SELECT COUNT(*), SUM(v) FROM t;
----
16 28
