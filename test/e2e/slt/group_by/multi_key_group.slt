# GROUP BY on more than one column: each distinct (g1, g2) pair is its own group.

statement ok
CREATE TABLE t(g1 INT, g2 INT, v INT);

statement ok
INSERT INTO t VALUES (1,1,10),(1,1,20),(1,2,30),(2,1,40);

query rowsort
SELECT g1, g2, COUNT(*), SUM(v) FROM t GROUP BY g1, g2;
----
1 1 2 30
1 2 1 30
2 1 1 40

# All rows with a NULL group key collapse into a single group (SQL-standard).
statement ok
CREATE TABLE n(g INT, v INT);

statement ok
INSERT INTO n VALUES (NULL, 1), (NULL, 2), (5, 3);

query rowsort
SELECT g, COUNT(*), SUM(v) FROM n GROUP BY g;
----
5 1 3
NULL 2 3
