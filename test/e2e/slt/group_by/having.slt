# HAVING filters groups after aggregation.

statement ok
CREATE TABLE sales(region INT, amt INT);

statement ok
INSERT INTO sales VALUES (1,100),(1,200),(2,50),(2,50),(3,10);

# Keep only groups with more than one row.
query rowsort
SELECT region, COUNT(*) FROM sales GROUP BY region HAVING COUNT(*) > 1;
----
1 2
2 2

# HAVING on a different aggregate than the one selected.
query rowsort
SELECT region, COUNT(*) FROM sales GROUP BY region HAVING SUM(amt) >= 100;
----
1 2
2 2

# A HAVING that excludes every group returns no rows.
query
SELECT region FROM sales GROUP BY region HAVING COUNT(*) > 100;
----
