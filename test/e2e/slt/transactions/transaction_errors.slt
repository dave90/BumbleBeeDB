# Error and edge-case handling for explicit transactions: nested BEGIN, stray COMMIT/ROLLBACK, a failed
# statement aborting the whole transaction, and rejection of non-transactional DDL.

statement ok
CREATE TABLE t(id INT PRIMARY KEY, v INT);

# A stray COMMIT / ROLLBACK with no open transaction is an error.
statement error
COMMIT;

statement error
ROLLBACK;

# Nested BEGIN is rejected (there are no savepoints).
statement ok
BEGIN;

statement error
BEGIN;

# The first transaction is still open after the rejected nested BEGIN — clean it up.
statement ok
ROLLBACK;

# --- A failed statement aborts the whole transaction ---------------------------------------------

statement ok
INSERT INTO t VALUES (1, 10);

statement ok
BEGIN;

statement ok
INSERT INTO t VALUES (2, 20);

# This duplicate-key INSERT fails, which aborts the transaction (discarding the (2,20) write too).
statement error
INSERT INTO t VALUES (1, 99);

# The transaction is already gone, so COMMIT now finds nothing to commit.
statement error
COMMIT;

# Only the row committed before the transaction survives; (2,20) was rolled back with the abort.
query rowsort
SELECT id, v FROM t;
----
1 10

# --- DDL is rejected until catalog mutations become transactional ----------------------------------
# This preserves the transaction's long-lived shared schema lease and avoids irreversible catalog work.

statement ok
BEGIN;

statement error
CREATE TABLE ephemeral(x INT);

statement ok
ROLLBACK;

# Nothing was created.
statement error
SELECT * FROM ephemeral;
