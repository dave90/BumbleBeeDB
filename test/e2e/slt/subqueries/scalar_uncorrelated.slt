# Uncorrelated scalar subqueries: `(SELECT single_value ...)` used as a value anywhere an
# expression may appear. The subquery is pre-executed once per statement (it is uncorrelated, so
# its value is the same for every outer row): 0 rows -> NULL, more than 1 row -> error.

statement ok
CREATE TABLE t (v INT, s VARCHAR);

statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CREATE TABLE u (w INT);

statement ok
INSERT INTO u VALUES (10), (20);

# In a WHERE predicate.
query
SELECT v FROM t WHERE v = (SELECT min(v) FROM t);
----
1

# In the SELECT list (broadcast to every outer row).
query rowsort
SELECT v, (SELECT max(w) FROM u) FROM t;
----
1 20
2 20
3 20

# Inside arithmetic.
query rowsort
SELECT v FROM t WHERE v < (SELECT count(*) FROM u) + 1;
----
1
2

# As an element of an IN list.
query rowsort
SELECT v FROM t WHERE v IN (3, (SELECT min(w) FROM u) - 9);
----
1
3

# Nested: a subquery inside a subquery.
query
SELECT v FROM t WHERE v = (SELECT min(x.v) FROM t x WHERE x.v > (SELECT min(w) FROM u) - 9);
----
2

# 0 rows -> NULL.
query
SELECT (SELECT w FROM u WHERE w = 15);
----
NULL

# A NULL scalar compares to nothing.
query
SELECT v FROM t WHERE v = (SELECT w FROM u WHERE w = 15);
----

# More than one row -> error.
statement error
SELECT v FROM t WHERE v = (SELECT w FROM u);

# A subquery over strings.
query
SELECT v FROM t WHERE s = (SELECT min(s) FROM t);
----
1

# DML: INSERT / UPDATE / DELETE with a scalar subquery.
statement ok
INSERT INTO t VALUES ((SELECT max(v) FROM t) + 10, 'x');

query
SELECT v FROM t WHERE s = 'x';
----
13

statement ok
UPDATE t SET v = (SELECT max(w) FROM u) WHERE s = 'x';

query
SELECT v FROM t WHERE s = 'x';
----
20

statement ok
DELETE FROM t WHERE v = (SELECT max(v) FROM t);

query rowsort
SELECT v FROM t;
----
1
2
3

# EXPLAIN must not execute the subquery: the plan renders it as a placeholder.
statement ok
EXPLAIN SELECT v FROM t WHERE v = (SELECT min(v) FROM t);

# A correlated subquery is still out of reach, with a pointed error.
statement error
SELECT a.v FROM t a WHERE a.v = (SELECT max(b.v) FROM t b WHERE b.v < a.v);
