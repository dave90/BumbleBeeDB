# \vacuum sweeps superseded manifests + orphan part files; row-group pruning (min/max
# statistics) must never change results — these queries hit pruned and unpruned paths.

statement ok
CREATE TABLE t (a INT, b VARCHAR) WITH (format='parquet', location='${TMPDIR}/t');

# Two part files with disjoint ranges: [1,3] and [100,200].
statement ok
INSERT INTO t VALUES (1,'a'),(2,'b'),(3,'c');

statement ok
INSERT INTO t VALUES (100,'x'),(200,'y');

# Predicates that prune the first, the second, both, or neither file's row group.
query
SELECT COUNT(*) FROM t WHERE a > 50;
----
2

query
SELECT COUNT(*) FROM t WHERE a <= 3;
----
3

query
SELECT COUNT(*) FROM t WHERE a < 0;
----
0

query rowsort
SELECT a FROM t WHERE a >= 2 AND a <= 100;
----
100
2
3

# Prunable predicate combined with an unprunable string predicate.
query
SELECT b FROM t WHERE a > 50 AND b = 'x';
----
'x'

# Rewrites leave old manifests + (after crash, orphan files) behind; \vacuum sweeps them.
statement ok
UPDATE t SET b = 'B' WHERE a = 2;

statement ok
DELETE FROM t WHERE a = 200;

statement ok
\vacuum t

# The table reads identically after the sweep.
query rowsort
SELECT a, b FROM t;
----
1 'a'
100 'x'
2 'B'
3 'c'

# Vacuum on a heap table is refused.
statement ok
CREATE TABLE h (x INT);

statement error
\vacuum h
