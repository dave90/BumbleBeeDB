# ORDER BY on multiple keys with mixed ASC/DESC directions (a stable sort).

statement ok
CREATE TABLE t(g INT, a INT);

statement ok
INSERT INTO t VALUES (2,5),(1,9),(1,3),(2,1),(1,9);

query
SELECT g, a FROM t ORDER BY g ASC, a DESC;
----
1 9
1 9
1 3
2 5
2 1

query
SELECT g, a FROM t ORDER BY g DESC, a ASC;
----
2 1
2 5
1 3
1 9
1 9
