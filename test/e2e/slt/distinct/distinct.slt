# SELECT DISTINCT (lowered to a group-by on all output columns). NULLs collapse to a single row.

statement ok
CREATE TABLE t(a INT, b INT);

statement ok
INSERT INTO t VALUES (1,10),(1,10),(2,20),(2,30),(1,10);

query rowsort
SELECT DISTINCT a FROM t;
----
1
2

query rowsort
SELECT DISTINCT a, b FROM t;
----
1 10
2 20
2 30

# DISTINCT over a column with duplicate NULLs keeps one NULL.
statement ok
CREATE TABLE n(x INT);

statement ok
INSERT INTO n VALUES (1),(NULL),(1),(NULL),(2);

query rowsort
SELECT DISTINCT x FROM n;
----
1
2
NULL
