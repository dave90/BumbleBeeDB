# Multi-column equi keys: rows equal on the first key column but different on the second must not
# join (the key verify filters column by column), and a NULL in ANY key column disqualifies the row.

statement ok
CREATE TABLE t1(a INT, b VARCHAR, v INT);

statement ok
INSERT INTO t1 VALUES (1,'x',10),(1,'y',11),(2,'x',20),(1,NULL,12);

statement ok
CREATE TABLE t2(a INT, b VARCHAR, v INT);

statement ok
INSERT INTO t2 VALUES (1,'x',100),(1,'z',101),(2,'x',200),(1,NULL,300);

query rowsort
SELECT t1.v, t2.v FROM t1 JOIN t2 ON t1.a = t2.a AND t1.b = t2.b;
----
10 100
20 200

# LEFT: the partial-key matches and NULL-key rows survive NULL-padded.
query rowsort
SELECT t1.v, t2.v FROM t1 LEFT JOIN t2 ON t1.a = t2.a AND t1.b = t2.b;
----
10 100
11 NULL
12 NULL
20 200
