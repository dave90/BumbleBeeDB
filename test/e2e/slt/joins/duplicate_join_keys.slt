# Duplicate keys on BOTH sides: SQL bag semantics — the join emits the full cross product per key
# (the build table must keep duplicate-key rows as separate entries, never dedup them).

statement ok
CREATE TABLE l(k INT, lv INT);

statement ok
INSERT INTO l VALUES (1,10),(1,11),(2,20),(3,30);

statement ok
CREATE TABLE r(k INT, rv INT);

statement ok
INSERT INTO r VALUES (1,100),(1,101),(2,200),(4,400);

# key 1: 2 x 2 = 4 rows; key 2: 1 row; keys 3 and 4 match nothing.
query rowsort
SELECT l.k, l.lv, r.rv FROM l JOIN r ON l.k = r.k;
----
1 10 100
1 10 101
1 11 100
1 11 101
2 20 200

# LEFT keeps the unmatched left rows once, NULL-padded, alongside the duplicated matches.
query rowsort
SELECT l.k, l.lv, r.rv FROM l LEFT JOIN r ON l.k = r.k;
----
1 10 100
1 10 101
1 11 100
1 11 101
2 20 200
3 30 NULL

# Self-join over duplicates: key 1 contributes 2 x 2 rows again.
query rowsort
SELECT a.lv, b.lv FROM l a JOIN l b ON a.k = b.k;
----
10 10
10 11
11 10
11 11
20 20
30 30
