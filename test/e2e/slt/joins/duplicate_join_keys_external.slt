# Duplicate keys through the out-of-core grace hash join: partitioning and the per-leaf tables must
# also keep bag semantics (full cross product per key). prefer_external forces the grace variant.
# config: prefer_external=true

statement ok
CREATE TABLE l(k INT, lv INT);

statement ok
INSERT INTO l VALUES (1,10),(1,11),(2,20),(3,30);

statement ok
CREATE TABLE r(k INT, rv INT);

statement ok
INSERT INTO r VALUES (1,100),(1,101),(2,200),(4,400);

query rowsort
SELECT l.k, l.lv, r.rv FROM l JOIN r ON l.k = r.k;
----
1 10 100
1 10 101
1 11 100
1 11 101
2 20 200
