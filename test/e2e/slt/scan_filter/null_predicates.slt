# NULL handling end to end: the untyped NULL literal fits a column of any type (VARCHAR, BIGINT,
# DOUBLE — not just INT), `IS NULL` / `IS NOT NULL` select rows by validity, and a comparison
# against NULL yields no rows (SQL three-valued logic: NULL = anything is not true). Also pins
# BIGINT-range integer literals, which the parser hands over as strings.

statement ok
CREATE TABLE s(id INT PRIMARY KEY, name VARCHAR(64), big BIGINT, x DOUBLE);

# NULLs into VARCHAR / BIGINT / DOUBLE columns, mixed with typed values in the same VALUES list.
statement ok
INSERT INTO s VALUES (1, NULL, 9223372036854775807, NULL),
                     (2, 'bob', -9223372036854775807, 2.5),
                     (3, NULL, NULL, NULL);

# BIGINT extremes round-trip (integer literals beyond INT32 are BIGINT, not DOUBLE).
query rowsort
SELECT id, name, big, x FROM s;
----
1 NULL 9223372036854775807 NULL
2 'bob' -9223372036854775807 2.5
3 NULL NULL NULL

# --- IS NULL / IS NOT NULL select rows by validity -------------------------------------------------

query rowsort
SELECT id FROM s WHERE name IS NULL;
----
1
3

query
SELECT id FROM s WHERE name IS NOT NULL;
----
2

query
SELECT id FROM s WHERE big IS NULL;
----
3

# IS NULL composes with other predicates.
query
SELECT id FROM s WHERE name IS NULL AND big IS NOT NULL;
----
1

# --- A comparison against NULL matches nothing (it is NULL, not true) ------------------------------

query
SELECT COUNT(*) FROM s WHERE big = NULL;
----
0

query
SELECT COUNT(*) FROM s WHERE big <> NULL;
----
0

# --- UPDATE can null out and re-fill a column of any type ------------------------------------------

query
UPDATE s SET name = NULL WHERE id = 2;
----
1

query
SELECT COUNT(*) FROM s WHERE name IS NULL;
----
3

query
UPDATE s SET name = 'carol' WHERE id = 2;
----
1

query
SELECT name FROM s WHERE id = 2;
----
'carol'

# --- Bare NULL projection and aggregates over NULLs ------------------------------------------------

query
SELECT NULL;
----
NULL

# COUNT(*) counts NULL rows; SUM skips them.
query
SELECT COUNT(*), SUM(x) FROM s;
----
3 2.5
