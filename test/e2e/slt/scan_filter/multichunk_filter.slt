# Regression test for a result-collector bug found via the small-vector build: a filter that produces
# several result chunks, each selecting a DIFFERENT set of positions, must not corrupt earlier chunks.
# The filter emits its matches as a dictionary over a reused selection vector; the breaker must
# materialize each stored batch independently, or a later batch's selection retroactively rewrites an
# earlier one (it would read the wrong rows). Needs multiple chunks, so it runs under the small-vector
# build (STANDARD_VECTOR_SIZE=4): the 8 rows span two chunks.
# require: small_vector

statement ok
CREATE TABLE t(a INT);

statement ok
INSERT INTO t VALUES (10),(20),(30),(40),(50),(60),(70),(80);

# Matches the last row of chunk 1 (index 3 -> 40) and all of chunk 2. If chunk 1's selection is
# corrupted by chunk 2's, the 40 turns into an earlier value.
query rowsort
SELECT a FROM t WHERE a > 35;
----
40
50
60
70
80

# Scattered matches in both chunks at different local offsets.
query rowsort
SELECT a FROM t WHERE a = 20 OR a = 70;
----
20
70

# Only the first chunk matches (later chunk selects nothing) — the earlier passing case.
query rowsort
SELECT a FROM t WHERE a < 25;
----
10
20
